# ========================================
# IBM Calc Pro - Environment Configuration
# ========================================

# Application
NODE_ENV=development
APP_NAME=IBM Calc Pro
APP_VERSION=2.0.0

# Server Configuration
PORT=3000
API_URL=http://localhost:3000/api
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_AUTH_MODE=bearer
VITE_AUTH_HEADER=Authorization
VITE_AUTH_TOKEN_KEY=ibm_token
VITE_AUTH_TOKEN_PREFIX=Bearer 
VITE_AUTH_REFRESH_URL=/api/auth/refresh
VITE_AUTH_REFRESH_METHOD=POST
VITE_AUTH_REFRESH_MODE=cookie
VITE_AUTH_REFRESH_TOKEN_KEY=ibm_refresh_token
VITE_AUTH_REFRESH_BODY_FIELD=refreshToken
VITE_AUTH_REFRESH_HEADER=X-Refresh-Token
VITE_SSO_LOGIN_URL=http://localhost:3000/api/auth/sso/login
VITE_SSO_LABEL=IBM Enterprise SSO
VITE_SSO_REDIRECT_PARAM=redirect

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cnc_calc_pro
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Configuration (Optional - for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this
JWT_REFRESH_EXPIRE=30d
REFRESH_ROTATE=true
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_HEADER=X-Refresh-Token
REFRESH_TOKEN_BODY_FIELD=refreshToken
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Session
SESSION_SECRET=your_session_secret_change_this

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=8151968533:AAElu22QpnDP-3NbaLBwsPvmUz05UEXhTEY
TELEGRAM_CHAT_ID=294782364
TELEGRAM_ENABLED=true

# Claude AI Integration
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_ENABLED=true

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=.nc,.txt,.gcode,.pdf,.xlsx,.dxf

# G-Code Processing
GCODE_TEMP_DIR=./temp/gcode
GCODE_ARCHIVE_DIR=./archive/gcode
MAX_GCODE_SIZE=10485760

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# Email (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
EMAIL_FROM=noreply@cnc-calc-pro.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# WebSocket
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=5000

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Security
BCRYPT_ROUNDS=10
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=3600000

# Machine Monitoring
MACHINE_STATUS_UPDATE_INTERVAL=5000
SERIES_PROGRESS_UPDATE_INTERVAL=10000

# Notifications
NOTIFICATION_ENABLED=true
NOTIFICATION_CHANNELS=telegram,email
ALERT_THRESHOLD_LOW=20
ALERT_THRESHOLD_CRITICAL=10

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90
ENABLE_AI_INSIGHTS=true

# Development
DEBUG=false
ENABLE_SWAGGER=true
SWAGGER_URL=/api-docs

# Production
FORCE_HTTPS=true
TRUST_PROXY=true

# ========================================
# Notes:
# ========================================
# 1. Copy this file to .env and fill in your values
# 2. Never commit .env file to version control
# 3. Use strong passwords and secrets in production
# 4. Keep your API keys secure
# 5. Update JWT secrets regularly
# ========================================
